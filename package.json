{
  "name": "@nestjs-cms/core",
  "version": "0.1.0",
  "description": "Definition-driven NestJS CMS with S3 attachments",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "start": "node dist/src/main.js",
    "test": "jest --runInBand",
    "test:integration": "jest --runInBand --config jest.integration.config.cjs",
    "db:migrate": "typeorm-ts-node-commonjs migration:run -d src/database/data-source.ts",
    "db:revert": "typeorm-ts-node-commonjs migration:revert -d src/database/data-source.ts",
    "db:generate": "typeorm-ts-node-commonjs migration:generate -d src/database/data-source.ts",
    "seed": "ts-node scripts/seed.ts",
    "storage:cleanup": "ts-node scripts/cleanup.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "npm run build",
    "pack:local": "npm pack",
    "release:check": "npm test && npm pack --dry-run",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release": "npm publish --access public",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.850.0",
    "dotenv": "^16.6.0",
    "mysql2": "^3.14.0",
    "pg": "^8.16.0",
    "typeorm": "^0.3.25",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.6.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.0",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "require": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src",
    "!dist/src/main.*",
    "!dist/src/app.module.*",
    "!dist/src/database/data-source.*",
    "!dist/src/database/migrations",
    "README.md",
    "docs",
    ".env.example"
  ],
  "peerDependencies": {
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  }
}

{
  "name": "@nestjs-cms/auth",
  "version": "0.1.0",
  "description": "Users, roles, and session authentication for NestJS CMS",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "jest --runInBand --config jest.config.cjs",
    "test:integration": "jest --runInBand --config jest.integration.config.cjs",
    "prepack": "npm run build",
    "release:check": "npm test && npm pack --dry-run",
    "version:patch": "npm version patch --no-git-tag-version",
    "version:minor": "npm version minor --no-git-tag-version",
    "version:major": "npm version major --no-git-tag-version",
    "release": "npm publish --access public",
    "prepublishOnly": "npm test"
  },
  "peerDependencies": {
    "@nestjs-cms/core": "^0.1.3",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.25"
  },
  "devDependencies": {
    "@nestjs-cms/core": "file:../..",
    "@nestjs/common": "^11.1.0",
    "@nestjs/core": "^11.1.0",
    "@nestjs/platform-express": "^11.1.0",
    "@nestjs/testing": "^11.1.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.0",
    "jest": "^30.0.0",
    "supertest": "^7.1.0",
    "ts-jest": "^29.4.0",
    "typescript": "^5.9.0",
    "typeorm": "^0.3.25"
  }
}

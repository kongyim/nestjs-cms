{
  "name": "@nestjs-cms/admin",
  "version": "0.1.0",
  "description": "Configuration-driven React admin portal for nestjs-cms",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "bin": { "cms-admin": "./scripts/cli.mjs" },
  "files": ["dist", "scripts/cli.mjs", "README.md"],
  "sideEffects": ["**/*.css"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-css.cjs",
    "test": "node --test test/*.test.cjs test/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": { "node": ">=20.9" },
  "peerDependencies": { "react": "^19.0.0", "react-dom": "^19.0.0" },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.23",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  }
}

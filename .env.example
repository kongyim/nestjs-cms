NODE_ENV=development
PORT=3000
HOST=127.0.0.1
CORS_ORIGINS=http://localhost:5173,http://localhost:3001
# Optional shared API key for development/integration; rights/auth module is out of scope.
ADMIN_API_KEY=
DB_TYPE=postgres
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USERNAME=cms
DB_PASSWORD=cms_dev_password
DB_DATABASE=cms
# Dev only. Use migrations in production.
DB_SYNCHRONIZE=true
S3_REGION=us-east-1
S3_BUCKET=cms-attachments
S3_ENDPOINT=http://127.0.0.1:9000
# Browser-reachable endpoint for signed URLs; defaults to S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=http://127.0.0.1:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_URL_TTL_SECONDS=300
ATTACHMENT_MAX_BYTES=20971520
